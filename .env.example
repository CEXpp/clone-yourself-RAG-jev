# 从项目根目录普通启动即可加载：java -jar target/digital-twin-0.1.0.jar
# 按 Java properties 的 KEY=value 格式填写：不要加引号，不写 export。
# Windows 路径使用 /；值内如有反斜杠需写为双反斜杠。
# 此 .env 为本地私有配置；不要把真实密钥填入 .env.example。

# 本地服务与数据
PORT=8080
DATA_DIR=./data
DEMO_DATA=true
HTTP_TIMEOUT_SECONDS=8

# JEV：密钥留空时使用本地规则
JEV_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_API_KEY=
JEV_THRESHOLD=0.65

# 生成模型：填写完整端点、模型名称、密钥；留空使用本地摘录
GEN_URL=https://api.openai.com/v1/chat/completions
GEN_MODEL=
GEN_API_KEY=

# Embedding：模型输出须为1-1024维；留空使用本地演示向量
EMBED_URL=https://api.openai.com/v1/embeddings
EMBED_MODEL=
EMBED_API_KEY=

# .env 由聊天服务的 Spring 配置加载；离线导入仍显式传 --app.data-dir。